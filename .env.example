# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG RAG CHATBOT NGHỊ ĐỊNH 116/2020/NĐ-CP
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép tệp này thành .env:
#      copy .env.example .env (trên Windows PowerShell/CMD)
#      cp .env.example .env   (trên Linux/macOS)
# 2. Điền thông tin kết nối và API key thực tế của bạn vào file .env.
# 3. Tệp .env đã được cấu hình trong .gitignore để không bao giờ bị đẩy lên git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (Bắt buộc / Required)
# ------------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL (hỗ trợ cả PostgreSQL cục bộ hoặc dịch vụ cloud như NeonDB, Supabase).
# Cần quyền tạo bảng, extension pg_trgm và pgvector.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH INDEXING & EMBEDDING (Tùy chọn / Option)
# ------------------------------------------------------------------------------
# (Option) Mô hình sinh vector nhúng từ Hugging Face.
# Mặc định: BAAI/bge-m3. Tất cả mô hình đều sinh vector 1024 chiều.
#
# Các mô hình được hỗ trợ (có thể dùng alias hoặc tên đầy đủ):
#   bge-m3              → BAAI/bge-m3               (FlagEmbedding, 8192 tokens)
#   vnlegal-lal         → darklethelong/vnlegal-lal  (SentenceTransformer, 2048 tokens)
#   vietlegal-harrier   → mainguyen9/vietlegal-harrier-0.6b (SentenceTransformer, 512 tokens)
#   vietlegal-e5        → mainguyen9/vietlegal-e5    (SentenceTransformer + E5 prefix, 512 tokens)
#   jina-v3             → jinaai/jina-embeddings-v3   (Jina LoRA adapters, 8192 tokens)
#   deepx               → dxtech-asia/deepx-embedding-v1 (SentenceTransformer, 8192 tokens)
#
# Mỗi mô hình ghi embedding vào cột riêng trong legal_chunks, tránh trộn lẫn
# vector từ các mô hình khác nhau.
EMBEDDING_MODEL=BAAI/bge-m3

# (Option) Kích thước batch khi sinh embedding.
# Gợi ý thiết lập theo tài nguyên phần cứng:
# - GPU 4GB - 6GB VRAM (ví dụ NVIDIA RTX 3050 Laptop): 4 hoặc 8 (tránh lỗi CUDA Out Of Memory)
# - GPU >= 8GB - 16GB VRAM: 16 hoặc 32
# - Chạy thuần CPU: 16 hoặc 32
# Mặc định nếu không thiết lập: 8 (hoặc 32 khi chạy dòng lệnh không truyền --batch-size)
EMBEDDING_BATCH_SIZE=8

# (Option) Token truy cập Hugging Face (Hugging Face User Access Token).
# Giúp tăng giới hạn tải (rate limits) và tải mô hình nhanh hơn từ Hugging Face Hub.
# Lấy token tại: https://huggingface.co/settings/tokens
HF_TOKEN=

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MÔ HÌNH NGÔN NGỮ LỚN (LLM) (Tùy chọn / Option - Phục vụ giai đoạn sau)
# ------------------------------------------------------------------------------
# (Option) Khóa API Google Gemini để phục vụ giai đoạn sinh câu trả lời (Generation / Synthesis).
# Lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=
